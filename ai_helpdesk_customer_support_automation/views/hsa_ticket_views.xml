<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="hsa_ticket_view_tree" model="ir.ui.view">
            <field name="name">hsa.ticket.view.tree</field>
            <field name="model">hsa.ticket</field>
            <field name="arch" type="xml">
                <list string="AI Helpdesk Tickets">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="subject"/>
                    <field name="priority" widget="priority"/>
                    <field name="category"/>
                    <field name="ai_sentiment"/>
                    <field name="state" widget="badge"/>
                    <field name="assigned_to"/>
                    <field name="created_date"/>
                    <field name="response_time_hours"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="hsa_ticket_view_form" model="ir.ui.view">
            <field name="name">hsa.ticket.view.form</field>
            <field name="model">hsa.ticket</field>
            <field name="arch" type="xml">
                <form string="AI Helpdesk Ticket">
                    <header>
                        <button name="action_assign" type="object" string="Assign" class="oe_highlight"
                                invisible="state != 'new'"/>
                        <button name="action_start_progress" type="object" string="Start Progress" class="oe_highlight"
                                invisible="state != 'assigned'"/>
                        <button name="action_resolve" type="object" string="Resolve" class="oe_highlight"
                                invisible="state != 'in_progress'"/>
                        <button name="action_close" type="object" string="Close"
                                invisible="state != 'resolved'"/>
                        <button name="action_reset_to_new" type="object" string="Reset to New"
                                invisible="state == 'new'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="new,assigned,in_progress,resolved,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_assign" type="object" string="Assign" class="oe_stat_button"
                                    icon="fa-user-plus" invisible="state != 'new'"/>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Ticket Reference"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="subject"/>
                                <field name="priority" widget="priority"/>
                                <field name="category"/>
                                <field name="assigned_to"/>
                            </group>
                            <group>
                                <field name="ai_sentiment"/>
                                <field name="ai_category_prediction"/>
                                <field name="ai_priority_prediction"/>
                                <field name="created_date"/>
                                <field name="resolved_date"/>
                                <field name="response_time_hours"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="hsa_ticket_action" model="ir.actions.act_window">
            <field name="name">AI Helpdesk Tickets</field>
            <field name="res_model">hsa.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new AI helpdesk ticket
                </p>
            </field>
        </record>
    </data>
</odoo>
