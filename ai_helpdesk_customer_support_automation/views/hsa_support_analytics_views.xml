<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="hsa_support_analytics_view_tree" model="ir.ui.view">
            <field name="name">hsa.support.analytics.view.tree</field>
            <field name="model">hsa.support.analytics</field>
            <field name="arch" type="xml">
                <tree string="Support Analytics">
                    <field name="name"/>
                    <field name="period"/>
                    <field name="total_tickets"/>
                    <field name="avg_response_time"/>
                    <field name="avg_resolution_time"/>
                    <field name="satisfaction_score"/>
                    <field name="ai_automation_rate"/>
                    <field name="top_category"/>
                    <field name="escalation_rate"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="hsa_support_analytics_view_form" model="ir.ui.view">
            <field name="name">hsa.support.analytics.view.form</field>
            <field name="model">hsa.support.analytics</field>
            <field name="arch" type="xml">
                <form string="Support Analytics">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="period"/>
                                <field name="total_tickets"/>
                                <field name="avg_response_time"/>
                                <field name="avg_resolution_time"/>
                            </group>
                            <group>
                                <field name="satisfaction_score"/>
                                <field name="ai_automation_rate"/>
                                <field name="top_category"/>
                                <field name="escalation_rate"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="hsa_support_analytics_action" model="ir.actions.act_window">
            <field name="name">Support Analytics</field>
            <field name="res_model">hsa.support.analytics</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new support analytics record
                </p>
            </field>
        </record>
    </data>
</odoo>
